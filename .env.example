# Example process environment. npm start does not load this file automatically.
# Use node --env-file=.env.local --experimental-strip-types src/server.ts if desired.
# Optional OpenAI-compatible provider. Leave the API key empty for offline demo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Replace with a model ID supported by your gateway before enabling the API provider.
OPENAI_MODEL=your-model-id
# Token streaming; set to 0 for servers that mishandle stream=true.
# OPENAI_STREAM=1
PORT=3030

# Optional local CLI routing. Leave unset to keep the offline LocalProvider demo.
# ORBIT_ATLAS_PROVIDER=codex
# ORBIT_FORGE_PROVIDER=claude-code
# ORBIT_LENS_PROVIDER=pi
# ORBIT_WORKSPACE_ROOT=.
# ORBIT_CODEX_COMMAND=codex
# ORBIT_CLAUDE_COMMAND=claude
# ORBIT_PI_COMMAND=pi
# ORBIT_ATLAS_CLI_TIMEOUT_MS=120000

# Optional native Anthropic provider. Used as default when OPENAI_API_KEY is empty,
# or when ORBIT_DEFAULT_PROVIDER=anthropic. Per agent: ORBIT_FORGE_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-anthropic-model-id
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_EFFORT=high
# Idle timeout: aborts when the stream produces nothing for this long.
# ANTHROPIC_TIMEOUT_MS=300000
# ANTHROPIC_MAX_TOKENS=64000
# ORBIT_DEFAULT_PROVIDER=anthropic

# Extra Host names allowed to reach the API (comma separated), e.g. behind a reverse proxy.
# ORBIT_ALLOWED_HOSTS=

# Web write/edit/shell tools need per-call approval. MCP autoApprove can bypass approval.
# read-only offers only registered read-only tools to models; external CLI tools are separate.
# ORBIT_TOOL_POLICY=approval
# ORBIT_APPROVAL_TIMEOUT_MS=600000
# ORBIT_SHELL=
# External MCP servers (Claude Desktop format); defaults to ./mcp.json when present.
# ORBIT_MCP_CONFIG=
